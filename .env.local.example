# Cấu hình Supabase cho Hệ thống Quản lý Cửa hàng Điện Nước
# Sao chép file này thành .env.local và điền thông tin từ Supabase Dashboard

# URL của Supabase project (lấy từ Settings > API trong Supabase Dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon/Public key (lấy từ Settings > API trong Supabase Dashboard)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# VAPID Public Key cho Web Push Notifications
# Tạo bằng: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here
